# Logistics Control Tower - Environment Configuration Template
# DO NOT ADD REAL SECRET KEYS OR CREDENTIALS HERE

# Application Environment
VITE_APP_ENV=development
VITE_APP_TITLE=Logistics Control Tower

# AWS Configuration (Public Identifiers Only)
VITE_AWS_REGION=us-east-1
VITE_AWS_COGNITO_USER_POOL_ID=us-east-1_example
VITE_AWS_COGNITO_CLIENT_ID=exampleclientid12345
VITE_AWS_APPSYNC_GRAPHQL_ENDPOINT=https://example.appsync-api.us-east-1.amazonaws.com/graphql
VITE_AWS_APPSYNC_EVENT_ENDPOINT=https://example.appsync-realtime.us-east-1.amazonaws.com/event

# Map Provider Config
VITE_MAPLIBRE_STYLE_URL=https://demotiles.maplibre.org/style.json

# Offline & Sync Options
VITE_OFFLINE_SYNC_INTERVAL_MS=5000
